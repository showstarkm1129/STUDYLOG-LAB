{
  "manifest_version": 3,
  "name": "Studylog Bridge",
  "version": "1.7.1",
  "icons": { "16": "icons/studylog-16.png", "32": "icons/studylog-32.png", "48": "icons/studylog-48.png", "128": "icons/studylog-128.png" },
  "key": "",
  "description": "スタログの学習情報を表示し、自由に構成できるカスタムページをダッシュボードで確認します。",
  "permissions": ["storage", "offscreen", "identity"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["https://portal.iwasaki.ac.jp/*"],
  "optional_host_permissions": ["https://slack.com/*", "https://hooks.slack.com/*", "https://discord.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": { "16": "icons/studylog-16.png", "32": "icons/studylog-32.png", "48": "icons/studylog-48.png", "128": "icons/studylog-128.png" },
    "default_title": "Studylog Dashboard を開く"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.iwasaki.ac.jp/lms/*",
        "https://portal.iwasaki.ac.jp/portal/lmsinc/*"
      ],
      "js": ["date-rules.js", "attendance-rules.js", "attendance-watch-rules.js", "digest-rules.js", "task-rules.js", "auto-sync-rules.js", "content.js", "iportal-api.js", "iportal.js", "iportal-inline.js"],
      "css": ["content.css", "iportal-inline.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://login.microsoftonline.com/*",
        "https://login.microsoft.com/*",
        "https://login.windows.net/*",
        "https://mysignins.microsoft.com/*",
        "https://account.activedirectory.windowsazure.com/*"
      ],
      "js": ["ms-signin-rules.js", "ms-signin.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js", "icons/studylog.svg"],
      "matches": ["https://portal.iwasaki.ac.jp/*"]
    }
  ]
}
