{
  "manifest_version": 3,
  "name": "Studylog Bridge",
  "version": "1.6.3",
  "description": "スタログの学習情報を表示し、自由に構成できるカスタムページをダッシュボードで確認します。",
  "permissions": ["storage"],
  "host_permissions": ["https://portal.iwasaki.ac.jp/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Studylog Dashboard を開く"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.iwasaki.ac.jp/lms/*",
        "https://portal.iwasaki.ac.jp/portal/lmsinc/*"
      ],
      "js": ["attendance-rules.js", "digest-rules.js", "task-rules.js", "auto-sync-rules.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://portal.iwasaki.ac.jp/*"]
    }
  ]
}
