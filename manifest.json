{
  "manifest_version": 3,
  "name": "Stalog Bridge + Lab",
  "version": "0.2.1",
  "description": "スタログの学習状況を端末内へ収集し、小さな便利ツール群で可視化します。",
  "permissions": ["storage"],
  "host_permissions": ["https://portal.iwasaki.ac.jp/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Stalog Lab を開く"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.iwasaki.ac.jp/lms/*",
        "https://portal.iwasaki.ac.jp/portal/lmsinc/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://portal.iwasaki.ac.jp/*"]
    }
  ]
}
